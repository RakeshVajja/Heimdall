# ========================================================
# Heimdall — AI Agent Platform Environment Configuration
# All external keys are 100% OPTIONAL (Free / Offline Fallbacks active)
# ========================================================

# Server Config
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Auth
JWT_SECRET=heimdall_ultra_secure_jwt_secret_key_2026_dev_mode
JWT_REFRESH_SECRET=heimdall_ultra_secure_refresh_secret_key_2026_dev_mode

# Primary LLM — Groq (Free tier API key: https://console.groq.com)
GROQ_API_KEY=

# Secondary LLM — Google Gemini (Free tier API key: https://aistudio.google.com)
GEMINI_API_KEY=

# Local LLM — Ollama (Default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Database — MongoDB Atlas M0 (Leave empty to use high-performance In-Memory Document Store)
MONGODB_URI=
MONGODB_USE_MEMORY_FALLBACK=false

# Cache / Sessions / Rate-limit — Upstash Redis (Leave empty for In-Memory Sliding Limiter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vector DB — Qdrant Cloud Free Tier (Leave empty for In-Memory Vector Store)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=heimdall_memories

# Web Search Tool — Tavily Free Tier (https://tavily.com)
TAVILY_API_KEY=

# GitHub Tool (Optional Personal Token for extended rate limits)
GITHUB_TOKEN=
